# host-agent/.env — wallet del HOST (la PC que sirve el juego y cobra).
# Copiar a host-agent/.env (NUNCA se commitea: .env está en .gitignore).
#
# Esta wallet firma reportFps() cada segundo de forma automática, por eso es una
# private key en archivo (no MetaMask). Es la que recibe los MON del cliente.

HOST_ADDRESS=0xTU_ADDRESS_DEL_HOST
HOST_PRIVATE_KEY=0xTU_PRIVATE_KEY_DEL_HOST

# Monad testnet
MONAD_TESTNET_RPC=https://testnet-rpc.monad.xyz
MONAD_TESTNET_CHAIN_ID=10143

# Se completa tras el deploy del contrato (WB3 de Dev A)
GHOSTRIG_CONTRACT_ADDRESS=

# rigId que te devuelve registerRig() cuando registres tu rig (WB4)
RIG_ID=
